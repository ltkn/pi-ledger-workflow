  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ltkn/pi-ledger-workflow.git"
  },
  "homepage": "https://github.com/ltkn/pi-ledger-workflow#readme",
  "files": [
    "extensions",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
